OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5-mini
# For OpenRouter, uncomment the base URL and set OPENAI_MODEL to its model ID.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=4096
# Reasoning models may need a lower effort to leave tokens for the answer.
# OPENAI_REASONING_EFFORT=low

AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_CALLS=20
AGENT_TIMEOUT_SECONDS=120
AGENT_REPEATED_CALL_LIMIT=2
AGENT_MAX_TOOL_FAILURES=3
AGENT_MAX_TOOL_OUTPUT_BYTES=60000
AGENT_MAX_SESSION_TURNS=12
AGENT_MAX_SESSION_CONTEXT_BYTES=240000
